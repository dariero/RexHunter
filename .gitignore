# Python
__pycache__/
*.py[cod]
# venv: uv's in-repo ./.venv (created by `uv sync`). Bare `.venv` (no trailing slash) so it
# is ignored as a directory or a symlink — `.venv/` only matches a real directory.
.venv

# Packaging / build artifacts
*.egg-info/
.eggs/

# OS
.DS_Store

# SQLite trajectory log
*.db
*.db-wal
*.db-shm

# Tool caches
.ruff_cache/
.pytest_cache/
